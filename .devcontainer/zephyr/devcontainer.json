{
  "name": "OpenRTX (zephyr)",
  "build": {
    "dockerfile": "../Containerfile",
    "target": "zephyr",
    "context": "../..",
    "args": {
      "BUILDKIT_STEP_LOG_MAX_SIZE": "10485760" // 10 MiB
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "mesonbuild.mesonbuild",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": [
    "/bin/sh", ".devcontainer/zephyr/post-create.sh"
  ]
}
