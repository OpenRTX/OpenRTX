# Always pin to digest for caching and repeatable builds
ARG BASE_IMAGE=docker.io/ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
ARG SOURCE=https://github.com/OpenRTX/OpenRTX

# Remote image for uv binary
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.7@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b
FROM $UV_IMAGE AS uv

# ----------------------------------------------------------------------
# Common base: development dependencies and uv for python management
# ----------------------------------------------------------------------
FROM $BASE_IMAGE AS base

LABEL org.opencontainers.image.source=$SOURCE

ENV DEBIAN_FRONTEND=noninteractive

# Install development dependencies
RUN apt-get update -y && apt-get install -y --no-install-recommends \
  build-essential \
  ca-certificates \
  cmake \
  dfu-util \
  file \
  git \
  libcodec2-dev \
  libncurses6 \
  libreadline-dev \
  libsdl2-dev \
  libusb-1.0-0-dev \
  patch \
  pkg-config \
  sudo \
  unzip \
  wget \
  xz-utils \
  && rm -rf /var/lib/apt/lists/*

# Add uv to manage Python dependencies
COPY --from=uv /uv /uvx /bin/

# ----------------------------------------------------------------------
# Tools stage: Build additional required tools from source
# ----------------------------------------------------------------------
FROM base AS tools

ARG RADIO_TOOL_VERSION=v0.5.0
RUN git clone --depth 1 --branch ${RADIO_TOOL_VERSION} https://github.com/v0l/radio_tool \
  && cmake -S radio_tool -B radio_tool/build \
  && cmake --build radio_tool/build -j$(nproc) \
  && cmake --install radio_tool/build --prefix /opt/radio_tool \
  && rm -rf radio_tool

RUN git clone --depth 1 --recurse-submodules --shallow-submodules https://github.com/LISTENAI/cskburn \
  && cmake -S cskburn -B cskburn/build \
  && cmake --build cskburn/build -j$(nproc) \
  && cmake --install cskburn/build --prefix /opt/cskburn \
  && rm -rf cskburn

# ----------------------------------------------------------------------
# Miosix stage: Adds the arm-miosix-eabi toolchain
# ----------------------------------------------------------------------
FROM base AS miosix

COPY --from=tools /opt/radio_tool /opt/radio_tool

# devcontainer passes the host architecture as $BUILDARCH (amd64/arm64)
ARG BUILDARCH

# Install the Miosix toolchain matching the host architecture
ARG OPENRTX_TOOLCHAINS="https://files.openrtx.org/toolchains"
RUN set -ex; \
  case "${BUILDARCH:-$(uname -m)}" in \
  amd64|x86_64) URL="${OPENRTX_TOOLCHAINS}/arm-miosix-eabi-x86_64.zip" ;; \
  arm64|aarch64) URL="${OPENRTX_TOOLCHAINS}/arm-miosix-eabi-aarch64.zip" ;; \
  *) echo "Unsupported architecture: ${BUILDARCH}"; exit 1 ;; \
  esac; \
  wget -O /tmp/arm-miosix-eabi.zip "$URL"; \
  unzip -q /tmp/arm-miosix-eabi.zip -d /opt; \
  rm /tmp/arm-miosix-eabi.zip

# Run as an ordinary user rather than root
USER ubuntu

# Virtual environment path
ENV VENV="/home/ubuntu/venv"

# Setup PATH
ENV PATH="/opt/arm-miosix-eabi/bin:$PATH"
ENV PATH="/opt/radio_tool/bin:$PATH"
ENV PATH="$VENV/bin:$PATH"

# Create and activate a virtual environment, using uv both to supply the
# interpreter (replacing the deadsnakes PPA) and to install into it.
COPY requirements.txt .
RUN uv venv --python 3.11 $VENV \
  && uv pip install --no-cache -r requirements.txt

# ----------------------------------------------------------------------
# Zephyr stage: Adds the Zephyr toolchains for the supported targets
# ----------------------------------------------------------------------
FROM base AS zephyr

COPY --from=tools /opt/cskburn /opt/cskburn

ARG BUILDARCH

# Space-separated list of toolchains to install, using full names
ARG ZEPHYR_TARGETS="arm-zephyr-eabi xtensa-espressif_esp32s3_zephyr-elf"
ARG ZEPHYR_SDK_VERSION=0.16.9

# Install the requested toolchains from the official minimal Zephyr SDK
ARG ZEPHYR_SDK="https://github.com/zephyrproject-rtos/sdk-ng/releases/download"
RUN set -ex; \
  case "${BUILDARCH:-$(uname -m)}" in \
  amd64|x86_64) HOSTARCH="x86_64" ;; \
  arm64|aarch64) HOSTARCH="aarch64" ;; \
  *) echo "Unsupported architecture: ${BUILDARCH}"; exit 1 ;; \
  esac; \
  URL="${ZEPHYR_SDK}/v${ZEPHYR_SDK_VERSION}/zephyr-sdk-${ZEPHYR_SDK_VERSION}_linux-${HOSTARCH}_minimal.tar.xz"; \
  wget -O /tmp/zephyr-sdk.tar.xz "$URL"; \
  mkdir -p /opt/zephyr-sdk; \
  tar -xf /tmp/zephyr-sdk.tar.xz -C /opt/zephyr-sdk --strip-components=1; \
  rm /tmp/zephyr-sdk.tar.xz; \
  SETUP_ARGS=""; \
  for TOOLCHAIN in $ZEPHYR_TARGETS; do \
    SETUP_ARGS="${SETUP_ARGS} -t ${TOOLCHAIN}"; \
  done; \
  /opt/zephyr-sdk/setup.sh $SETUP_ARGS; \
  mkdir -p /opt/zephyr-sdk/bin; \
  for TOOLCHAIN in $ZEPHYR_TARGETS; do \
    for bin in "/opt/zephyr-sdk/${TOOLCHAIN}"/bin/*; do \
      ln -sf "$bin" /opt/zephyr-sdk/bin/; \
    done; \
  done

# Run as an ordinary user rather than root
USER ubuntu

# Virtual environment path
ENV VENV="/home/ubuntu/venv"

# Setup PATH
ENV PATH="/opt/zephyr-sdk/bin:$PATH"
ENV PATH="/opt/cskburn/bin:$PATH"
ENV PATH="$VENV/bin:$PATH"

# Required by CMake to find the Zephyr toolchain binaries
ENV ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk
ENV ZEPHYR_TOOLCHAIN_VARIANT=zephyr

# Create and activate a virtual environment, using uv both to supply the
# interpreter (replacing the deadsnakes PPA) and to install into it.
COPY requirements.txt .
RUN uv venv --python 3.11 $VENV \
  && uv pip install --no-cache -r requirements.txt west pyelftools pyserial
